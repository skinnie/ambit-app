__pycache__/
*.pyc
csrc/build/
venv/

# PyInstaller build tooling/output: venvs bake in absolute paths of the machine that
# created them, so they must never travel between machines (this broke a real Mac
# build once - "bad interpreter", the venv's own python3 shebang pointed at a Linux
# path). Regenerated automatically by tools/packaging/build_*.sh on first run.
tools/packaging/.build-venv/
build/

# PyInstaller's actual output (the packaged Workout Builder binaries/.app bundles) -
# regenerated by tools/packaging/build_*.sh, same "build output, not source" reasoning as
# build/ above.
dist/

# Debug screenshots from troubleshooting real packaging build failures - scratch, not source.
tools/packaging/error*.jpg

# Analysis artifacts, deliberately not versioned on a public repository:
#  - SuuntoLink binaries and decompilation: proprietary Suunto software
#  - Microsoft redistributable DLLs
#  - pcap captures: they carry the watch serial number and personal POIs (home)
assets/
full-assets/

# Field reports pasted straight from a `write_nav.py settings` run: they quote BLE
# link keys and a phone MAC verbatim. Their findings belong in HANDOFF.md, with the
# values redacted; the raw notes stay local.
HANDOFF-append-*.md

# ambitapp-v2's own build tree and one-off cmake/make stdout captures made while
# iterating on real builds - scratch, not source.
ambitapp-v2/build/
ambitapp-v2/*.log
ambitapp-v2/*.exitcode
